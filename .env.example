# Environment (set to production for live deployment)
APP_ENV=production

# Database Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=veesta

# Session settings
# Set to true in production if running on HTTPS to enable secure session cookies
SESSION_SECURE=false

# Google OAuth 2.0 Credentials (Optional - can also be configured via Admin Settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_ENABLED=false

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ENABLED=true

